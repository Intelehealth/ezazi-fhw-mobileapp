# See src/config/env.ts. Every var below is optional — when unset, the
# corresponding env.ts field is just an empty string, not a placeholder
# fake host, so a call made without it fails loudly (a real error, not a
# fake domain silently going nowhere) instead of masking that it's unset.
VITE_APP_ENV=development

# Reverse-proxy path prefix this build is served under, e.g. erevamp's
# `/intelehealth` — leave unset for root deployments (including local dev).
# See src/config/env.ts / src/routes/app.routes.tsx.
VITE_BASE_PATH=

VITE_AUTH_GATEWAY_URL=https://erevamp.intelehealth.org:3030
VITE_PORTAL_URL=
VITE_CONFIG_URL=

# The OpenMRS REST API itself — confirmed against the real
# erevamp.intelehealth.org host. NOT the same as VITE_PORTAL_URL above (see
# src/config/env.ts's own note). Backs the doctor-profile feature's
# provider/person/attribute calls (src/services/profile.service.ts).
VITE_OPENMRS_URL=https://erevamp.intelehealth.org/openmrs/ws/rest/v1

# The separate Node "mindmap" service backing the doctor-profile feature's
# email/phone "already exists" check (src/services/profile.service.ts's
# validateProviderAttribute). Host not confirmed yet — left blank/env-driven,
# same as VITE_PORTAL_API_PROXY_TARGET below.
VITE_MINDMAP_URL=

# Which @ezazi/config-backed client's branding to render (see
# src/config/clients/). 'default' (eZAZI) or 'nepal' — unset/unknown falls
# back to 'default'. Mirrors apps/mobile's EXPO_PUBLIC_CLIENT_ID.
VITE_CLIENT_ID=default

# Google reCAPTCHA v2 site key (src/components/common/recaptcha.component.tsx).
# Unset falls back to Google's published "always passes" test key — no real
# per-client key is checked into this repo (Angular's captcha site keys are
# generated at build time from a secret).
VITE_RECAPTCHA_SITE_KEY=6LePS4wtAAAAAKRkiQ0MzeDtQFrrqBnFKSNMxly1

# Dev-only reverse proxy target for '/portal-api' (see vite.config.ts).
# TODO(EZAZI_PORTAL_PROXY): intelehealth-hw-webapp-react's vite.config.ts
# proxies '/portal-api' -> a hardcoded intelehealth.org dev host; eZAZI's own
# dev portal host isn't confirmed yet. Left blank: vite.config.ts simply
# omits the '/portal-api' route entirely when this is unset, rather than
# wiring it to a fake host.
VITE_PORTAL_API_PROXY_TARGET=
