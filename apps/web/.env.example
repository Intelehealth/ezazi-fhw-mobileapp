# See src/config/env.ts. Every var below is optional — when unset, env.ts
# falls back to @ezazi/config's DEFAULT_SERVERS (placeholder example.org
# hosts, see packages/config/src/servers.ts) so `npm run dev` still boots.
# Set these once the real eZAZI doctor-portal dev hosts are confirmed.
VITE_APP_ENV=development
VITE_AUTH_GATEWAY_URL=
VITE_PORTAL_URL=
VITE_CONFIG_URL=

# Dev-only reverse proxy target for '/portal-api' (see vite.config.ts).
# TODO(EZAZI_PORTAL_PROXY): intelehealth-hw-webapp-react's vite.config.ts
# proxies '/portal-api' -> a hardcoded intelehealth.org dev host; eZAZI's own
# dev portal host isn't confirmed yet, so this is left blank/env-driven.
VITE_PORTAL_API_PROXY_TARGET=
