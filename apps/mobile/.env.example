# Public env vars (exposed to client; never put secrets here)

# Selects the client/country config baked into this build (src/core/config/clients).
# Determines brand colors, country code, calendar system (BS/AD), default
# locale, and (with EXPO_PUBLIC_APP_ENV below) which server URLs to use —
# offline-safe since it's inlined into the JS bundle at build time.
EXPO_PUBLIC_CLIENT_ID=nepal

# Selects which of that client's server sets to use: development | preview | production.
# Server URLs themselves are NOT set here — each client defines its own
# development/preview/production endpoints in src/core/config/clients/<id>.ts.
EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_FEATURE_FLAG_STAGE3=true
EXPO_PUBLIC_FEATURE_FLAG_POSTPARTUM_MONITORING=true

EXPO_PUBLIC_SENTRY_DSN=
