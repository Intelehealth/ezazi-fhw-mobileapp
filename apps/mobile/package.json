{
  "name": "@ezazi/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "eLCG FHW (Frontline Health Worker / Nurse) Mobile App — React Native + Expo.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:nepal": "EXPO_PUBLIC_CLIENT_ID=nepal expo start -c",
    "start:default": "EXPO_PUBLIC_CLIENT_ID=default expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "build": "echo \"no local build — use eas build\""
  },
  "dependencies": {
    "@ezazi/api-client": "*",
    "@ezazi/config": "*",
    "@ezazi/types": "*",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "expo": "54",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.14",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-localization": "~17.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "i18next": "^23.15.2",
    "intl-pluralrules": "^2.0.1",
    "nepali-date-converter": "^3.4.0",
    "react": "19.1.0",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.2",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@hookform/resolvers": "^3.9.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.7.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  }
}
