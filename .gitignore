# Dependencies (hoisted to root by npm workspaces, but also matches
# apps/*/node_modules and packages/*/node_modules)
node_modules/

# Turborepo cache
.turbo/

# Expo cache (created at the root when a workspace command runs from here)
.expo/
.expo-shared/

# Package build output
dist/
*.tsbuildinfo

# Coverage
coverage/

# Env files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# package-lock.json is intentionally NOT ignored. It must be committed so that
# every dev machine and CI get identical dependency versions. CI
# (.github/workflows/*-ci.yml) uses actions/setup-node with `cache: 'npm'` and
# `npm ci`, both of which fail when no lock file is found in the repo.
# package-lock.json
