{
  "name": "ezazi-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo: FHW mobile app (Expo/React Native) + doctor webapp (React/Vite) + shared packages.",
  "engines": {
    "node": ">=20 <21"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=apps/mobile",
    "mobile:android": "npm run android --workspace=apps/mobile",
    "mobile:ios": "npm run ios --workspace=apps/mobile",
    "web": "npm run dev --workspace=apps/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "expo": "~53.0.27"
  }
}
